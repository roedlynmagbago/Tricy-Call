<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#222222"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nasugbu"
                    android:textColor="#222222"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRICY-CALL"
                    android:textColor="#222222"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dispatch &amp; Service Zone"
                    android:textColor="#777777"
                    android:textSize="9sp" />

            </LinearLayout>

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:textColor="#333333"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/contact_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/round_dark"
                android:src="@drawable/contact_icon"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Contact" />



        </LinearLayout>


        <!-- Account switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#E5EAED"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- CREATE ACCOUNT -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tab_inactive"
                android:gravity="center"
                android:text="CREATE ACCOUNT"
                android:textColor="#555555"
                android:textSize="11sp" />

            <!-- LOG IN - ACTIVE -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tab_active"
                android:gravity="center"
                android:text="LOG IN"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Welcome section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/round_chip"
            android:padding="5dp"
            android:text="NASUGBU MOBILITY PORTAL"
            android:textColor="#087F82"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Welcome back!"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log in to your Nasugbu tricycle account."
            android:textColor="#777777"
            android:textSize="12sp" />

        <!-- User Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="7dp"
            android:background="#F1F5F8"
            android:orientation="horizontal"
            android:padding="6dp">

            <!-- COMMUTER -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <!-- Commuter Icon -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/round_icon"
                    android:padding="9dp"
                    android:src="@drawable/commuter_icon"
                    android:scaleType="centerInside"
                    android:contentDescription="Commuter icon" />

                <!-- Text -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Commuter"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Passenger"
                        android:textColor="#777777"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- TODA DRIVER -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <!-- Driver Icon -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/round_icon_gray"
                    android:padding="9dp"
                    android:src="@drawable/driver_icon"
                    android:scaleType="centerInside"
                    android:contentDescription="TODA Driver icon" />

                <!-- Text -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TODA Driver"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Franchise Unit"
                        android:textColor="#777777"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Passenger status -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="✓  Verified passenger · Nasugbu resident / guest"
            android:textColor="#555555"
            android:textSize="9sp" />


        <!-- Mobile number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile Number"
                android:textColor="#333333"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMobileNumber"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/round_field"
                android:hint="+63 917 842 5901"
                android:inputType="phone"
                android:padding="10dp"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/round_field"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:text="Enter the mobile number linked to your dispatch profile or franchise certificate."
                android:textColor="#777777"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/round_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/round_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Enter your password"
                        android:inputType="textPassword"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/ivShowPassword"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="2dp"
                        android:src="@drawable/ic_visibility"
                        android:contentDescription="Show password" />

                </LinearLayout>


            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:gravity="center_vertical"
                android:text="□  Remember this device                                       30 days"
                android:textColor="#555555"
                android:textSize="10sp" />

        </LinearLayout>


        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="LOG IN TO DISPATCH"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Don't have an account yet?  Create an account"
            android:textColor="#777777"
            android:textSize="10sp" />

    </LinearLayout>

</ScrollView>
